# Copy to .env (gitignored) and fill in. Nothing here is required for the skeleton to start.

PORT=3000

# Browser origins allowed by CORS (comma separated). Default: the Expo web dev server.
# Native apps (Android/iOS builds) are not subject to CORS.
CORS_ORIGINS=http://localhost:8081

# Postgres connection string for the APPLICATION role (least privilege, never the owner or postgres).
# Migrations use DATABASE_MIGRATE_URL (owner role) - see db/README.md. On the VM both live in ~/sugarsense-db.env.
# Project Settings -> Database (pooler URL recommended for a long-running server).
DATABASE_URL=
DATABASE_MIGRATE_URL=

# Supabase project (Project Settings -> API). The service-role key bypasses row-level
# security: keep it server-side only and never ship it in the mobile app.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini API key for the server-side meal-photo analysis endpoint (POST /meals/analyze).
# From Google AI Studio (aistudio.google.com/apikey). Never put this in the mobile app -
# only the backend calls Gemini. Free-tier keys may have prompts used to improve Google's
# products - use a paid-tier key before any real user's meal photos go through this.
GEMINI_API_KEY=

# Optional: override the pinned Gemini model string used by POST /meals/analyze (default:
# gemini-3.8-flash, see backend/src/meals/providers/gemini-meal-vision.provider.ts). Lets ops roll
# a model forward/back without a code deploy. Whatever is actually configured here is what gets
# stored as model_version on every meal record.
GEMINI_MODEL=

# Optional: a second Gemini model tried once, inside the same attempt, when the first answers 429 or 5xx (overload).
# Must be a model id valid for your key that supports thinking levels (e.g. gemini-3.7-flash). The model that actually
# answered is stored as model_version. After an overload the retry also waits 4 s instead of 0.5 s.
GEMINI_FALLBACK_MODEL=

# Forecast service on the VM (GET /glucose). Server-side only; never in the mobile app.
# On the VM this is loopback. Locally use an SSH port forward, or leave the token empty
# (the endpoint then answers status "unavailable").
FORECAST_API_URL=http://127.0.0.1:8001
FORECAST_API_TOKEN=
# Optional: minutes before a reading counts as stale (default 20; keep equal to upstream FORECAST_STALE_MIN).
GLUCOSE_STALE_MINUTES=

# Optional shared secret for GET /glucose and POST /meals/analyze. When set, clients must send header
# X-App-Token with this value (401 otherwise). Unset = open. A token baked into the public web build is
# visible to anyone, so this is bot/scanner protection, not user authentication.
APP_API_TOKEN=
# Optional rate-limit overrides (fixed window: meals 10 min, glucose 1 min). Per client address / all clients.
RATE_LIMIT_MEALS_PER_IP=
RATE_LIMIT_MEALS_GLOBAL=
RATE_LIMIT_GLUCOSE_PER_IP=
RATE_LIMIT_GLUCOSE_GLOBAL=

# Optional: pin the single prototype user row (a UUID). Default: the oldest user row, created on first use.
PRIMARY_USER_ID=
# Optional rate-limit overrides for /forecast, /events, /therapy (per minute; per client address / all clients).
RATE_LIMIT_FORECAST_PER_IP=
RATE_LIMIT_FORECAST_GLOBAL=
