# Copy to .env (gitignored) and fill in. Nothing here is required for the skeleton to start.

PORT=3000

# Browser origins allowed by CORS (comma separated). Default: the Expo web dev server.
# Native apps (Android/iOS builds) are not subject to CORS.
CORS_ORIGINS=http://localhost:8081

# Postgres connection string. For Supabase use the "Connection string" from
# Project Settings -> Database (pooler URL recommended for a long-running server).
DATABASE_URL=

# Supabase project (Project Settings -> API). The service-role key bypasses row-level
# security: keep it server-side only and never ship it in the mobile app.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
