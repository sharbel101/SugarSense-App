# /etc/sugarsense-deploy.env - no secrets belong here.
# Branch to deploy. Set to `release` to promote work manually (git push origin main:release).
DEPLOY_BRANCH=main
REPO_URL=https://github.com/sharbel101/SugarSense-App.git

BUILD_DIR=/home/ubuntu/sugarsense-deploy/src
STATE_DIR=/var/lib/sugarsense-deploy
RELEASES_DIR=/var/www/releases
WEB_LINK=/var/www/sugarsense-web
WEB_CHECK_URL=http://127.0.0.1:8090
BACKEND_DIR=/home/ubuntu/sugarsense-app
BACKEND_HEALTH_URL=http://127.0.0.1:3000/health
BACKEND_RESTART_CMD="sudo systemctl restart sugarsense-backend"
KEEP_RELEASES=5
RETRY_AFTER_SEC=1800
