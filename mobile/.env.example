# Copy to .env.local (gitignored). Only EXPO_PUBLIC_* variables are exposed to the app bundle - never
# put secrets here; anything in the bundle is readable by whoever has the app.

# Base URL of the NestJS backend.
#  - Expo web in the browser on this PC:  http://localhost:3000
#  - Android emulator:                    http://10.0.2.2:3000
#  - Physical phone:                      http://<this PC's LAN IP>:3000  (same Wi-Fi; allow the
#                                         port through Windows Firewall) - and add the origin to
#                                         the backend's CORS_ORIGINS only if testing from a browser.
EXPO_PUBLIC_API_URL=http://localhost:3000
